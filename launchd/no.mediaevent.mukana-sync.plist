<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>no.mediaevent.mukana-sync</string>
  <key>ProgramArguments</key>
  <array>
    <!-- Adjust: `which node` -->
    <string>/opt/homebrew/bin/node</string>
    <string>/path/to/mukana-mimolive-sync/src/server.js</string>
  </array>
  <key>WorkingDirectory</key><string>/path/to/mukana-mimolive-sync</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PORT</key><string>8790</string>
    <key>UI_PASSWORD</key><string>change-me</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/tmp/mukana-sync.log</string>
  <key>StandardErrorPath</key><string>/tmp/mukana-sync.log</string>
</dict>
</plist>
